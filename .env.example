# ═══════════════════════════════════════════════════════════
# MochiBot — Environment Configuration
# Copy this file to .env and fill in your values
# For the full list of ~70 tunables, see mochi/config.py
# ═══════════════════════════════════════════════════════════

# ── Main model (required) ────────────────────────────────
# Adapters: "openai" or "anthropic".
# DeepSeek uses https://api.deepseek.com/v1 with the openai adapter.
# Gemini uses https://generativelanguage.googleapis.com/v1beta/openai/
# with the openai adapter.
# Other OpenAI-compatible services may set their HTTPS API root in MAIN_BASE_URL.
MAIN_PROVIDER=openai
MAIN_API_KEY=your-api-key-here
MAIN_MODEL=                    # e.g. gpt-4o, deepseek-chat, claude-sonnet-4-20250514
# MAIN_BASE_URL=

# ── Lite model (required) ────────────────────────────────
# Used only for personality-free classification, extraction, and validation.
# Assign it in the admin portal. It may point to the same registry model as Main.

# ── Embedding / Vector Search (optional) ─────────────────
# Enables vector-enhanced memory recall. Without this, memory uses keyword search only.
# Providers: openai or none. Bailian and Azure AI Foundry use the same adapter:
# https://dashscope.aliyuncs.com/compatible-mode/v1
# https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=
#
# EMBEDDING_CACHE_MAX_SIZE=128
# EMBEDDING_CACHE_TTL_S=300
#
# Native vector KNN search (requires: pip install sqlite-vec)
# Without sqlite-vec, recall falls back to keyword + Python cosine — works, just slower.
# VEC_SEARCH_NATIVE_ENABLED=true
# VEC_EMBEDDING_DIM=1536

# ── Transport — Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Transport — WeChat (optional) ────────────────────────
# Run `python scripts/weixin_auth.py` to scan QR code and get your token.
# WEIXIN_ENABLED=false
# WEIXIN_BOT_TOKEN=
# WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
# WEIXIN_ALLOWED_USERS=                # comma-separated; empty = allow all
# WEIXIN_POLL_TIMEOUT_S=35
# WEIXIN_BUBBLE_DELAY_S=1.0
# WEIXIN_MSG_LIMIT=4000
# WEIXIN_BACKOFF_MIN_S=2               # min backoff delay on poll error (seconds)
# WEIXIN_BACKOFF_MAX_S=30              # max backoff delay on poll error (seconds)
# WEIXIN_MAX_CONSECUTIVE_FAILURES=3    # failures before session-level reconnect
# WEIXIN_SESSION_EXPIRED_RETRY_S=300   # retry interval after session expiry (seconds)

# ── Heartbeat ────────────────────────────────────────────
# Auto-imported to DB on first startup. After that, manage via admin portal.
# Manual .env edits take effect on restart (overrides DB).
HEARTBEAT_INTERVAL_MINUTES=20
# ATTENTION_INTERVAL_MINUTES=60
# Advanced (usually no need to change):
# PROACTIVE_COOLDOWN_SECONDS=1800    # min gap between Attention deliveries
# LLM_HEARTBEAT_TIMEOUT_SECONDS=120  # timeout for LLM calls in heartbeat loop

# ── Free Time ────────────────────────────────────────────
# Slots are laid across the configured awake window (default 08:00-00:00),
# even buckets + jitter, at least 15 minutes apart. Starting mid-window
# does not pack leftovers into the evening; past times expire. Hard ceiling
# is how many 15-minute points fit in that window (64). Daily quota defaults
# to 32, not the window maximum. 0 disables Free Time.
MAX_DAILY_FREE_TIME=32
# FREE_TIME_AWAKE_START=08:00
# FREE_TIME_AWAKE_END=00:00
# FREE_TIME_SEARCH_SHARE=0.2
# FREE_TIME_UNAVAILABLE_FLOOR_MINUTES=45

# ── Sleep/Wake State Machine ─────────────────────────────
# Default rest hours are 01:00-08:00. Silence of 1 hour in that window
# starts sleep; user messages do not wake during rest. Auto-wake is the
# sleep window's end (WAKE_EARLIEST_HOUR). Until the owner speaks in the
# awake period, Free Time still consumes slots but fires at most every
# FREE_TIME_UNAVAILABLE_FLOOR_MINUTES.
# Both the sleep window and Free Time window can be changed in the admin
# 相处偏好 page; these env keys only seed the DB when the setting is missing.
# WAKE_EARLIEST_HOUR=8
# SLEEP_AFTER_HOUR=1
# SILENCE_PAUSE_DAYS=3.0             # days of silence → pause all proactive
# SILENCE_THRESHOLD_HOURS=1.0        # hours of silence in the rest window → sleep

# ── Conversation Summary ────────────────────────────────
# Lite continuously rolls each fixed batch into one durable summary.
# MAX_HISTORY_TURNS=10                  # recent complete turns kept verbatim
# CONV_SUMMARY_BATCH_TURNS=20           # complete turns per summary update
# CONV_SUMMARY_MAX_TOKENS=300           # rolling summary output budget

# ── Memory ───────────────────────────────────────────────
# MEMORY_EXTRACTION_BATCH_TURNS=10      # complete normal-chat turns per Lite batch
CORE_MAX_TOKENS=1400
# TRASH_PURGE_DAYS=30
# RECALL_DECAY_HALF_LIFE_DAYS=30    # recency decay half-life for recall scoring

# ── Memory Recall Weights ────────────────────────────────
# RECALL_VEC_SIM_THRESHOLD=0.25     # min cosine similarity for vector matches
# RECALL_BM25_WEIGHT=2.0            # weight for BM25 text search
# RECALL_VEC_SIM_WEIGHT=6.0         # weight for vector similarity
# RECALL_KEYWORD_BOOST=1.0          # bonus score when BM25 keyword match exists
# RECALL_FTS_CANDIDATE_MULTIPLIER=5 # expand FTS candidates: limit * N
# RECALL_FALLBACK_LIMIT=100         # max candidates before scoring phase
# VEC_SEARCH_CANDIDATE_LIMIT=50     # max K for vec0 KNN search

# ── Memory Auto-Recall (pre-turn retrieval) ─────────────
# FTS/LIKE text recall is always available; Embedding only adds semantic candidates.
# MEMORY_AUTO_RECALL=true             # master switch (default: on)
# MEMORY_AUTO_RECALL_TOP_K=5          # candidates to retrieve before filtering
# MEMORY_AUTO_RECALL_MAX_ITEMS=3      # max memories injected into prompt
# MEMORY_AUTO_RECALL_MIN_VEC_SIM=0.35 # vector-only admission threshold
# MEMORY_AUTO_RECALL_MAX_CHARS=320    # max chars per memory snippet
# MEMORY_AUTO_RECALL_MAX_TOKENS=600   # total related-memory block budget
# MEMORY_AUTO_RECALL_COOLDOWN=120     # cooldown after successful injection

# ── Knowledge Graph (entity-relationship triples) ───────
# Optional exact-entity index derived from source-backed Memory Items.
# KG_ENABLED=true                    # master switch (default: on)
# KG_MAX_ENTITY_CONTEXT_TOKENS=300   # max tokens per entity in prompt
# KG_ENTITY_MATCH_MIN_LENGTH=2       # min entity name length to match
# KG_MAX_TRIPLES_PER_ENTITY=20       # max relationships per entity query

# ── Maintenance ──────────────────────────────────────────
# Auto-imported to DB on first startup. After that, manage via admin portal.
# Manual .env edits take effect on restart (overrides DB).
MAINTENANCE_HOUR=3
# MAINTENANCE_ENABLED=true
# WEEKLY_MAINTENANCE_ENABLED=true
# WEEKLY_MAINTENANCE_MINUTE=15       # Monday, after successful Nightly

# ── Bedtime Main entry ───────────────────────────────────
# Main handles the sleep transition with its usual personality and abilities.
# BEDTIME_ENTRY_ENABLED=true
# BEDTIME_ENTRY_TIMEOUT_S=60          # timeout for the complete bedtime Main turn

# ── Diary ────────────────────────────────────────────────
# DIARY_STATUS_MAX_LINES=20
# DIARY_ENTRY_MAX_LINES=50

# ── Meal Reminder Hours ──────────────────────────────────
# Hour (0-23) after which an unlogged meal shows as pending (⏳) in diary status.
# MEAL_REMINDER_BREAKFAST_HOUR=10
# MEAL_REMINDER_LUNCH_HOUR=14
# MEAL_REMINDER_DINNER_HOUR=19

# ── Token Limits ─────────────────────────────────────────
# AI_CHAT_MAX_COMPLETION_TOKENS=4096
# TOOL_LOOP_MAX_ROUNDS=5
# TOOL_LOOP_PER_TOOL_LIMIT=5

# ── Tool Router / Governance ─────────────────────────────
# TOOL_ROUTER_ENABLED=true          # LLM-based skill selection (default: true)
# TOOL_ROUTER_MAX_TOKENS=100
# TOOL_ESCALATION_ENABLED=true      # mid-turn skill requests
# TOOL_ESCALATION_MAX_PER_TURN=4    # max successful escalations per turn (failed ones don't count)
# TOOL_DENY_NAMES=                  # comma-separated denylist of tool names
# TOOL_REQUIRE_CONFIRM=             # comma-separated tools requiring user confirmation
# TOOL_RATE_LIMIT_PER_MIN=10

# ── Chatty Rhythm (Telegram multi-bubble) ────────────────
# BUBBLE_ENABLED=true                # inject ||| splitting instruction into system prompt
# TG_INTERIM_ENABLED=true
# TG_BUBBLE_DELAY_S=1.0
# TG_BUBBLE_MAX=8
# TG_BUBBLE_DELIMITER=|||
# TG_BUBBLE_MIN_CHARS=8
# TG_AGGREGATE_ENABLED=true
# TG_STATUS_REACTIONS_ENABLED=true    # 👨‍💻/👍 reactions during tool calls
# TG_STATUS_MESSAGE_ENABLED=true      # "正在搜索…" status messages during tool calls
# TG_STATUS_EDIT_INTERVAL_S=1.0       # throttle status message edits (seconds)

# ── Observer Thresholds ──────────────────────────────────
# DELTA_SILENCE_JUMP_HOURS=1.5
# DELTA_NEW_TODOS=3
# OBSERVER_FAILURE_ALERT_THRESHOLD=3

# ── Weather Observer (optional, no API key needed) ──────
# WEATHER_CITY=Tokyo

# ── Log Compression (advanced) ───────────────────────────
# PET_LOG_WEEKLY_AFTER_DAYS=7
# PET_LOG_MONTHLY_AFTER_DAYS=30
# LIFE_LOG_WEEKLY_AFTER_DAYS=7
# LIFE_LOG_MONTHLY_AFTER_DAYS=30

# ── Database ─────────────────────────────────────────────
# HEARTBEAT_LOG_TRIM_DAYS=7
# HEARTBEAT_LOG_DELETE_DAYS=30

# ── Logging ──────────────────────────────────────────────
# LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── General ──────────────────────────────────────────────
# Auto-imported to DB on first startup. After that, manage via admin portal.
# Manual .env edits take effect on restart (overrides DB).
TIMEZONE_OFFSET_HOURS=8

# ── Web Search ─────────────────────────────────────────
# Built-in DuckDuckGo search — no API key needed, works out of the box.
# WEB_SEARCH_TIMEOUT_S=20

# ── Owner Info ───────────────────────────────────────────
# Your Telegram user ID (for owner-only commands)
# OWNER_USER_ID=123456789

# ── Admin Portal (optional) ─────────────────────────────
# Web-based setup & config portal. Requires: pip install fastapi uvicorn
# ADMIN_ENABLED=true              # set false to disable the portal
# ADMIN_PORT=8080                 # port for the web portal
# ADMIN_BIND=127.0.0.1            # default: localhost only; set 0.0.0.0 for remote access
# ADMIN_TOKEN=                    # set a token to require auth; leave empty for open access
